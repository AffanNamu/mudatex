# nginx replaces, rather than adds to, the headers of an outer block as soon as an inner block sets any header of its
# own. So the security headers live in one file that every location includes after its own headers.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  include /etc/nginx/conf.d/security-headers.inc;

  location = /healthz { access_log off; default_type text/plain; add_header Cache-Control "no-store"; include /etc/nginx/conf.d/security-headers.inc; return 200 "ok\n"; }

  # Built files have content hashes in their names.
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; include /etc/nginx/conf.d/security-headers.inc; try_files $uri =404; }

  # The page and its runtime settings must never be served stale.
  location = /config.js { add_header Cache-Control "no-store"; include /etc/nginx/conf.d/security-headers.inc; try_files $uri =404; }
  location / { add_header Cache-Control "no-cache"; include /etc/nginx/conf.d/security-headers.inc; try_files $uri /index.html; }
}
