# Where the Mudatex API lives. The API must list this app's origin in its CORS_ORIGINS.
VITE_API_URL=http://localhost:3000
# Sign-in is chosen by config.js at runtime (see public/config.js and docker/40-runtime-config.sh).
# For local work against a Supabase project, put this in public/config.js (do not commit it):
#   window.__MUDATEX__ = { supabaseUrl: "https://<ref>.supabase.co", supabaseKey: "<publishable key>" };
# With nothing set, the development sign-in is used (requires DEV_TOKEN_ENDPOINT=true on the API).
