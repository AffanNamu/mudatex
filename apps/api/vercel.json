{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && node scripts/vercel-release.mjs",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "migrations/**" }
  },
  "crons": [{ "path": "/internal/cron/worker", "schedule": "0 3 * * *" }]
}
